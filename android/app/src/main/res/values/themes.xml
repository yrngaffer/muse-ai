<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base platform theme used before Compose draws (prevents a white flash).
      All real UI theming is done in Compose (ui/theme). AppCompat is intentionally
      NOT a dependency, so we parent off the platform Material theme.
    -->
    <style name="Theme.Muse" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/muse_bg</item>
        <item name="android:navigationBarColor">@color/muse_bg</item>
        <item name="android:windowBackground">@color/muse_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
